# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Auth: change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Database. SQLite for dev (zero-config). For production, switch the
# datasource provider in server/prisma/schema.prisma to "postgresql" and
# point this at your Postgres instance, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/folio?schema=public"
# Path is resolved relative to server/prisma/ (the schema location).
DATABASE_URL="file:./dev.db"

# CORS origin for the dev front-end (Vite). In single-service production
# deploys the SPA is same-origin, so this is only used in dev.
CORS_ORIGIN=http://localhost:5173

# Path, relative to the built server (server/dist), to the SPA build served
# in production. Default resolves to folio/web/dist.
WEB_DIST=../web/dist
